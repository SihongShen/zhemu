    "outline": [
      {
        "id": "beat_01",
        "title": "归港",
        "summary": "沈鹭五年后回到雾港，小镇依旧被浓雾笼罩。她遇到修船的阿昌叔，老人劝她别再捞沉在海底的事。在听潮客栈落脚，老板娘阿珍话里有话地警告她别翻旧账。沈鹭对着姐姐的照片发誓要找回她。",
        "structure_tag": "setup",
        "chapter_range": [
          1,
          1
        ]
      },
      {
        "id": "beat_02",
        "title": "旧案",
        "summary": "沈鹭找到当年经手姐姐案子的退休刑警周明。周明承认自己没尽全力，透露沈鸿失踪前一周曾来打听如何匿名举报走私——这条线索从未写入案卷。周明劝她收手，暗示港里有人根扎得很深。",
        "structure_tag": "rising_action",
        "chapter_range": [
          2,
          2
        ]
      },
      {
        "id": "beat_03",
        "title": "最后的晚餐",
        "summary": "沈鹭到钱记海鲜调查姐姐失踪当晚的最后一餐。钱德旺言辞闪烁、恐惧异常。沈鹭偷翻旧账本，发现姐姐那天的记录旁有一行小字：'替阿昌带话，西仓，子时'。钱德旺发现后吓得打电话通风报信。",
        "structure_tag": "rising_action",
        "chapter_range": [
          3,
          3
        ]
      },
      {
        "id": "beat_04",
        "title": "照片与真相",
        "summary": "沈鹭夜探西边废弃仓库，阿昌现身，交出沈鸿五年前留给妹妹的信。信中揭示：沈鸿因追查走私被追杀，阿昌拼死救她，沈鸿泅水逃到对岸渔村躲藏至今。信中指出真正可怕的是那个穿制服、给走私望风通气的内鬼。阿昌确认沈鸿还活着，阿珍一直在接济她。",
        "structure_tag": "climax",
        "chapter_range": [
          4,
          5
        ]
      },
      {
        "id": "beat_05",
        "title": "雾散",
        "summary": "沈鹭得知姐姐还活着，追问内鬼身份。阿昌终于决定说出一切。沈鹭以记者的身份发誓要让见不得光的东西见光。天边泛起亮色，压了雾港五年的浓雾开始被风吹散。",
        "structure_tag": "resolution_setup",
        "chapter_range": [
          5,
          5
        ]
      }
    ]
  },
  "script": [
    {
      "id": "unit_ch1",
      "source_chapter": 1,
      "title": "第一章 归港",
      "summary": "沈鹭五年后回到雾港追查姐姐沈鸿失踪的真相。她在码头找到阿昌叔，老人劝她别再追问；在听潮客栈，老板娘阿珍也暗示她收手。沈鹭在房间里对着姐妹合影发誓，一定要把姐姐找回来。",
      "scenes": [
        {
          "id": "sc_1_01",
          "heading": {
            "int_ext": "EXT",
            "location": "雾港长途汽车站",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭乘长途车抵达雾港，浓雾弥漫，车站冷清无人招呼。她沿记忆中的石板路走向海边。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "shot",
              "text": "远景：一辆长途汽车在浓雾中缓缓停下，车灯在雾里晕成两团模糊的光。"
            },
            {
              "type": "action",
              "text": "发动机熄火，排气管咳出一口黑烟。车门打开，沈鹭拎着行李走下来。雾立刻贴上她的脸，她微微一激灵。"
            },
            {
              "type": "shot",
              "text": "中景：沈鹭站在空荡荡的车站，环顾四周。天和海混成一团灰白，分不清水与天的边界。"
            },
            {
              "type": "action",
              "text": "车站只有一盏路灯亮着，灯下蹲着两个三轮车夫，懒洋洋地抽烟。没人抬头看她，也没人招呼。"
            },
            {
              "type": "action",
              "text": "沈鹭把外套领子竖起来，拎紧行李，沿着记忆里的石板路往海边走去。"
            },
            {
              "type": "transition",
              "text": "切至：石板路街景"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_02",
          "heading": {
            "int_ext": "EXT",
            "location": "雾港镇石板路老街",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭走过老街，看到糖水铺和小学旧址，触发与姐姐沈鸿的童年回忆。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "action",
              "text": "路两边的铺子大多关着门。沈鹭经过一家糖水铺——招牌还在，玻璃却碎了一块，用纸板糊着。"
            },
            {
              "type": "action",
              "text": "她脚步稍缓，目光在招牌上停留片刻，继续往前走。"
            },
            {
              "type": "shot",
              "text": "中景：一座小学的铁门，锈得发红。沈鹭在门前停下。"
            },
            {
              "type": "action",
              "text": "沈鹭的手轻轻搭上锈迹斑斑的铁门栏杆，眼神柔软下来。"
            },
            {
              "type": "action",
              "text": "闪回画面：两个女孩——年幼的沈鹭和少女沈鸿——放学后手牵手走出校门。沈鸿一手牵着妹妹，一手举着一支冰棍，两个人分着吃。海风吹来，两个女孩的头发被吹向同一个方向。"
            },
            {
              "type": "dialogue",
              "character": "char_shenhong",
              "delivery": "V.O.",
              "line": "等攒够了钱，姐就带你离开雾港。去大城市，去有很多很多灯的地方。"
            },
            {
              "type": "action",
              "text": "沈鹭从回忆中回过神来，手指从铁门上滑落。她深吸一口气，继续往前走。"
            },
            {
              "type": "transition",
              "text": "切至：码头"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_03",
          "heading": {
            "int_ext": "EXT",
            "location": "雾港码头修船木棚",
            "time": "NIGHT"
          },
          "mode": "normal",
          "synopsis": "沈鹭在码头找到阿昌叔，追问姐姐失踪真相。阿昌手抖不止，劝她别再捞沉在海底的事。",
          "characters_present": [
            "char_shenlu",
            "char_achang"
          ],
          "elements": [
            {
              "type": "shot",
              "text": "广角：退潮后的海滩，黑色礁石裸露，几条小船搁浅在滩涂上。修船木棚里亮着一盏昏黄的灯。"
            },
            {
              "type": "action",
              "text": "棚子里，阿昌佝偻着身子蹲在船板边，借着灯光补网。鱼线在他手里一进一出，动作机械而缓慢。"
            },
            {
              "type": "action",
              "text": "沈鹭走近，在棚外停了一下，轻声开口。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "阿昌叔。"
            },
            {
              "type": "action",
              "text": "老人的手停住了。他抬起头，浑浊的眼睛在雾里费力地辨认。忽然手一抖，鱼线啪地落进水里。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "……是小鹭？你姐姐的事，过去这么多年了，你回来做什么。"
            },
            {
              "type": "action",
              "text": "沈鹭把行李放在船板上，在阿昌对面蹲下，目光平视老人。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我想知道她到底去了哪儿。周叔他们说是意外落水。可阿昌叔，您是看着我和姐姐在这片海边长大的，您比谁都清楚——沈鸿的水性，比港里大半的渔民都好。她不可能就那么淹死。"
            },
            {
              "type": "action",
              "text": "阿昌没有接话。他重新捡起鱼线，手指却抖得厉害，半天穿不进网眼。"
            },
            {
              "type": "shot",
              "text": "特写：阿昌那双布满老茧的手，鱼线在指尖颤抖。"
            },
            {
              "type": "action",
              "text": "过了很久，阿昌才把目光投向雾里看不见的海。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "有些事啊，沉到海底了，就别再捞了。捞上来的，未必是你想要的。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我想要的，是真相。"
            },
            {
              "type": "action",
              "text": "老人摇摇头，没再说话，只是一下一下地补着那张永远补不完的网。"
            },
            {
              "type": "action",
              "text": "沈鹭看了他片刻，知道今晚问不出什么了。她站起身，拍了拍裤子上的灰，转身离开。"
            },
            {
              "type": "shot",
              "text": "远景：沈鹭的背影渐行渐远。雾里，阿昌佝偻的身影一动不动，像一块被海水泡了太久的礁石。"
            },
            {
              "type": "transition",
              "text": "切至：听潮客栈"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_04",
          "heading": {
            "int_ext": "INT",
            "location": "听潮客栈前台",
            "time": "NIGHT"
          },
          "mode": "normal",
          "synopsis": "沈鹭入住听潮客栈，老板娘阿珍认出她后喜忧参半，暗示她不要翻旧账。",
          "characters_present": [
            "char_shenlu",
            "char_azhen"
          ],
          "elements": [
            {
              "type": "action",
              "text": "沈鹭推开客栈的门，门上的风铃叮当作响。阿珍正在柜台后整理账本，抬头一看，又惊又喜。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "哎哟，这不是小鹭嘛！你怎么……回来了？"
            },
            {
              "type": "action",
              "text": "阿珍的笑容里掺进了一丝别的东西——沈鹭捕捉到了，但没有点破。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "回来住几天。阿珍姐，给我开个看得见海的房间吧。"
            },
            {
              "type": "action",
              "text": "沈鹭把身份证递过去。阿珍接过，登记的手却慢了下来。她左右看了一眼，压低声音。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "小鹭，姐多嘴一句。你姐姐那事，镇上没人愿意提。你要是来散心，姐欢迎；你要是来翻旧账……"
            },
            {
              "type": "action",
              "text": "阿珍顿了顿，声音压得更低。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "这港子小，风一吹，什么话都传到不该传的人耳朵里。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "什么人？"
            },
            {
              "type": "action",
              "text": "阿珍像说漏了嘴，慌忙把钥匙塞进沈鹭手里，低下头去。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "二楼最里头那间。早点歇着，海边夜里凉。"
            },
            {
              "type": "action",
              "text": "阿珍低头忙别的，再不肯多看沈鹭一眼。沈鹭握紧钥匙，转身走向楼梯。"
            },
            {
              "type": "transition",
              "text": "切至：客栈二楼房间"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_05",

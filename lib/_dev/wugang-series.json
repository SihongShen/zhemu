    "outline": [
      {
        "id": "beat_01",
        "title": "归港",
        "summary": "沈鹭五年后回到雾港，小镇依旧被浓雾笼罩。她遇到修船的阿昌叔，老人劝她别再捞沉在海底的事。在听潮客栈落脚，老板娘阿珍话里有话地警告她别翻旧账。沈鹭对着姐姐的照片发誓要找回她。",
        "structure_tag": "setup",
        "chapter_range": [
          1,
          1
        ]
      },
      {
        "id": "beat_02",
        "title": "旧案",
        "summary": "沈鹭找到当年经手姐姐案子的退休刑警周明。周明承认自己没尽全力，透露沈鸿失踪前一周曾来打听如何匿名举报走私——这条线索从未写入案卷。周明劝她收手，暗示港里有人根扎得很深。",
        "structure_tag": "rising_action",
        "chapter_range": [
          2,
          2
        ]
      },
      {
        "id": "beat_03",
        "title": "最后的晚餐",
        "summary": "沈鹭到钱记海鲜调查姐姐失踪当晚的最后一餐。钱德旺言辞闪烁、恐惧异常。沈鹭偷翻旧账本，发现姐姐那天的记录旁有一行小字：'替阿昌带话，西仓，子时'。钱德旺发现后吓得打电话通风报信。",
        "structure_tag": "rising_action",
        "chapter_range": [
          3,
          3
        ]
      },
      {
        "id": "beat_04",
        "title": "照片与真相",
        "summary": "沈鹭夜探西边废弃仓库，阿昌现身，交出沈鸿五年前留给妹妹的信。信中揭示：沈鸿因追查走私被追杀，阿昌拼死救她，沈鸿泅水逃到对岸渔村躲藏至今。信中指出真正可怕的是那个穿制服、给走私望风通气的内鬼。阿昌确认沈鸿还活着，阿珍一直在接济她。",
        "structure_tag": "climax",
        "chapter_range": [
          4,
          5
        ]
      },
      {
        "id": "beat_05",
        "title": "雾散",
        "summary": "沈鹭得知姐姐还活着，追问内鬼身份。阿昌终于决定说出一切。沈鹭以记者的身份发誓要让见不得光的东西见光。天边泛起亮色，压了雾港五年的浓雾开始被风吹散。",
        "structure_tag": "resolution_setup",
        "chapter_range": [
          5,
          5
        ]
      }
    ]
  },
  "script": [
    {
      "id": "unit_ch1",
      "source_chapter": 1,
      "title": "第一章 归港",
      "summary": "沈鹭五年后回到雾港追查姐姐沈鸿失踪的真相。她在码头找到修船老人阿昌，阿昌欲言又止，劝她别再追问。随后她在听潮客栈落脚，老板娘阿珍也暗示镇上有人不愿旧事重提。沈鹭在房间对着姐妹合影立誓要找回姐姐。",
      "scenes": [
        {
          "id": "sc_1_01",
          "heading": {
            "int_ext": "INT_EXT",
            "location": "长途汽车站/雾港镇口",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭乘长途汽车抵达雾港，浓雾弥漫，车站冷清，她沿记忆中的石板路走向海边。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "action",
              "text": "浓雾中，一辆长途汽车缓缓停稳。发动机熄火，排气管咳出一缕黑烟，随即被雾气吞没。"
            },
            {
              "type": "action",
              "text": "车门打开，沈鹭拎着行李走下来。咸腥的雾气立刻贴上她的脸颊，她微微一激灵，站定，环顾四周。"
            },
            {
              "type": "action",
              "text": "雾港的天和海混成一团灰白，分不清水与天的边界。车站只有一盏路灯亮着，灯下蹲着两个三轮车夫，懒洋洋地抽烟，没人抬头看她。"
            },
            {
              "type": "action",
              "text": "沈鹭把外套领子竖起来，拎紧行李，沿着记忆里的石板路往海边走去。"
            },
            {
              "type": "action",
              "text": "路两边的铺子大多关着门。她经过一家糖水铺——招牌还在，玻璃却碎了一块，用纸板糊着。她脚步顿了顿，继续往前走。"
            },
            {
              "type": "action",
              "text": "再往前，是一所小学，铁门锈得发红。沈鹭停住，望着校门出神。"
            },
            {
              "type": "action",
              "text": "闪回画面：多年前的放学时分，少女沈鸿站在校门口，一手牵着年幼的沈鹭，一手举着一支冰棍，两个女孩分着吃。海风把她们的头发吹向同一个方向。"
            },
            {
              "type": "action",
              "text": "沈鹭从回忆中回过神，眼神沉了沉，继续往码头方向走去。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_02",
          "heading": {
            "int_ext": "EXT",
            "location": "码头/修船木棚",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭在码头找到修船老人阿昌，追问姐姐失踪真相。阿昌言辞闪烁，劝她别再打捞沉入海底的旧事。",
          "characters_present": [
            "char_shenlu",
            "char_achang"
          ],
          "elements": [
            {
              "type": "action",
              "text": "石板路的尽头是码头。退潮了，海滩上裸露着黑色礁石和搁浅的小船。修船的木棚立在老地方，棚子里亮着一盏昏黄的灯。"
            },
            {
              "type": "action",
              "text": "一个佝偻的身影蹲在船板边，借着灯光补网。是阿昌。"
            },
            {
              "type": "action",
              "text": "沈鹭走近，在棚外站了片刻，轻声开口。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "阿昌叔。"
            },
            {
              "type": "action",
              "text": "老人的手停住了。他抬起头，浑浊的眼睛在雾里辨认了半天。忽然手一抖，鱼线啪地落进水里。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "……是小鹭？"
            },
            {
              "type": "action",
              "text": "他的声音又干又涩。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "你姐姐的事，过去这么多年了，你回来做什么。"
            },
            {
              "type": "action",
              "text": "沈鹭把行李放在船板上，在他对面蹲下。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我想知道她到底去了哪儿。周叔他们说是意外落水。可阿昌叔，您是看着我和姐姐在这片海边长大的，您比谁都清楚——沈鸿的水性，比港里大半的渔民都好。她不可能就那么淹死。"
            },
            {
              "type": "action",
              "text": "阿昌没有接话。他重新捡起鱼线，却半天没穿进网眼里。那双手抖得厉害。"
            },
            {
              "type": "action",
              "text": "过了很久，他才把目光投向雾里看不见的海。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "有些事啊，沉到海底了，就别再捞了。捞上来的，未必是你想要的。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我想要的，是真相。"
            },
            {
              "type": "action",
              "text": "老人摇摇头，没再说话，只是一下一下地补着那张永远补不完的网。"
            },
            {
              "type": "action",
              "text": "沈鹭看了他片刻，站起身，拍了拍裤子上的灰。临走前回头看了一眼——雾里，老人佝偻的背影一动不动，像一块被海水泡了太久的礁石。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_03",
          "heading": {
            "int_ext": "INT",
            "location": "听潮客栈前台/二楼房间",
            "time": "NIGHT"
          },
          "mode": "normal",
          "synopsis": "沈鹭在听潮客栈落脚，老板娘阿珍认出她后欲言又止，暗示镇上有人不愿旧事重提。沈鹭在房间对着姐妹合影立誓。",
          "characters_present": [
            "char_shenlu",
            "char_azhen"
          ],
          "elements": [
            {
              "type": "action",
              "text": "天彻底黑下来。沈鹭走进镇口的「听潮客栈」，前台亮着暖黄的灯光。"
            },
            {
              "type": "action",
              "text": "老板娘阿珍正低头算账，抬头看见沈鹭，先是一愣，随即又惊又喜。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "哎哟，这不是小鹭嘛！"
            },
            {
              "type": "action",
              "text": "笑容里很快掺进了别的东西。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "你怎么……回来了？"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "回来住几天。阿珍姐，给我开个看得见海的房间吧。"
            },
            {
              "type": "action",
              "text": "沈鹭把身份证递过去。阿珍接过，登记的手却慢了下来。她压低声音。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "小鹭，姐多嘴一句。你姐姐那事，镇上没人愿意提。你要是来散心，姐欢迎；你要是来翻旧账……"
            },
            {
              "type": "action",
              "text": "她顿了顿，目光扫了一眼门外。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "这港子小，风一吹，什么话都传到不该传的人耳朵里。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "什么人？"
            },
            {
              "type": "action",
              "text": "阿珍像说漏了嘴，慌忙把钥匙塞给她。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "二楼最里头那间。早点歇着，海边夜里凉。"
            },
            {
              "type": "action",
              "text": "说完便低头忙别的去了，再不肯多看她一眼。"
            },
            {
              "type": "action",
              "text": "沈鹭拎着行李上楼。房间不大，一床一桌，窗外就是漆黑的海。海浪声隐隐传来。"
            },
            {
              "type": "action",
              "text": "她从行李里取出一张照片，摆在桌上——照片里两个女孩并肩站在码头，小的那个咧着嘴笑，大的那个揽着妹妹的肩，眼睛却望着远处的海平线，像在想什么心事。"
            },
            {
              "type": "action",
              "text": "沈鹭凝视照片，指尖轻轻划过姐姐的脸。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "姐，我回来了。这次，我一定把你找回来。"
            },
            {
              "type": "action",
              "text": "窗外，雾压着海，海托着雾，一夜都没有散。"
            }
          ],
          "needs_review": false
        }
      ]
    },
    {
      "id": "unit_ch2",
      "source_chapter": 2,
      "title": "第二章 旧案",
      "summary": "沈鹭拜访退休老刑警周明。周明承认当年沈鸿案因上头催办、自身困境而草草结案，并透露沈鸿失踪前一周曾来打听举报走私的渠道——这条关键线索从未写入案卷。周明反复劝沈鹭收手，暗示背后势力盘根错节。沈鹭不为所动，决心追查到底。",
      "scenes": [
        {
          "id": "sc_2_01",
          "heading": {
            "int_ext": "EXT",
            "location": "半山腰周明家院子",
            "time": "DAY"
          },
          "mode": "normal",
          "synopsis": "沈鹭来到半山腰周明家，周明正在浇花，见到她后神色复杂，请她进屋。",
          "characters_present": [
            "char_shenlu",
            "char_zhouming"
          ],
          "elements": [
            {
              "type": "action",
              "text": "半山腰，一栋孤零零的旧砖房。院子里横七竖八晾着渔网，墙上挂着一张褪色的警队合影，玻璃相框落满灰。周明背对着门，正给几盆半死不活的兰花浇水。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "周叔。"
            },
            {
              "type": "action",
              "text": "浇水的手顿了顿。周明转过身——比五年前老了不止五岁，背驼了，头发白透。他看着沈鹭，浑浊的眼里闪过一丝复杂：意外、躲闪，还有一点说不清的愧。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "……进来吧。"
            },
            {
              "type": "action",
              "text": "他叹了口气。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "我就知道，你迟早会找上门。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_2_02",
          "heading": {
            "int_ext": "INT",
            "location": "周明家客厅",
            "time": "DAY"
          },
          "mode": "normal",
          "synopsis": "周明向沈鹭讲述沈鸿案始末，承认自己当年没尽全力，并透露沈鸿失踪前曾打听举报走私的事。",
          "characters_present": [
            "char_shenlu",
            "char_zhouming"
          ],
          "elements": [
            {
              "type": "action",
              "text": "屋里陈设简单，一张八仙桌，几把旧椅子。周明给沈鹭倒了杯粗茶，端杯子的手有点抖，茶水洒了几滴在桌上。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "沈鸿的案子，是我经手的。"
            },
            {
              "type": "action",
              "text": "他在她对面坐下，目光落在自己布满老年斑的手背上。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "那年她在钱记海鲜吃完晚饭，一个人往码头方向走，再没回来。第三天，西湾的渔民捞起一只女鞋，是她的。我们查了半个月，最后定了意外落水。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "半个月。"
            },
            {
              "type": "action",
              "text": "沈鹭重复这三个字，声音很轻，却像针。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "周叔，您当了一辈子刑警，破过那么多案子。我问您一句良心话——这个结论，您自己信吗？"
            },
            {
              "type": "action",
              "text": "周明没有立刻回答。他端起茶杯，又放下，喉结动了动。屋外的风穿过院子里的渔网，发出呜呜的声响，像谁在低声哭。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "那阵子，港里不太平。"
            },
            {
              "type": "action",
              "text": "他终于开口，声音压得很低。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "走私的、跑黑市的，半夜里船来船往，水浑得很。上头三天两头催着结案，说一个失踪案拖着影响渔汛、影响招商。我……我那时候快退休了，老婆又病着，等着用钱。"
            },
            {
              "type": "action",
              "text": "他闭上眼。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "我承认，那个案子，我没尽全力。"
            },
            {
              "type": "action",
              "text": "沈鹭的心一点点沉下去，可她仍逼着自己问下去。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "姐姐出事前，有没有什么反常？她有没有找过您，或者找过谁？"
            },
            {
              "type": "action",
              "text": "周明的身子几不可察地僵了一下。他沉默了很久，久到沈鹭以为他不会答了。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "出事前大概一个星期，沈鸿来过一趟所里。她说……她想问问，举报走私，该找哪个部门，怎么才能不被人知道是她报的。"
            },
            {
              "type": "action",
              "text": "老人的声音抖了起来。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "我当时只当她是好奇，随口应付了她几句。我要是当时多问一句，多留个心……"
            },
            {
              "type": "action",
              "text": "他没说下去，一只手捂住了脸。沈鹭的呼吸急了——姐姐失踪前一周去打听过怎么举报走私，这条线索，案卷里一个字都没有。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "这些，为什么不写进案卷？"
            },
            {
              "type": "action",
              "text": "周明放下手，眼神又恢复了那种躲闪的浑浊。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "小鹭，听叔一句劝。这港子小，认人。有些人，你现在看着是退了、老了、不管事了，可他们的根还扎在这片水底下，盘根错节。你一个姑娘家，查到一半最难收手——到时候，怕是连你自己都搭进去。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "那也比让我姐姐烂在一只鞋里强。"
            },
            {
              "type": "action",
              "text": "沈鹭站起身，声音不高，却字字咬得很死。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "周叔，谢谢您今天肯跟我说这些。我姐不是会半路放弃的人。"
            },
            {
              "type": "action",
              "text": "她在门口停下，回头。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我也不是。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_2_03",
          "heading": {
            "int_ext": "EXT",
            "location": "半山腰周明家院子外",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭离开周明家，雾又起来了。回头望去，周明仍坐在桌前，像一尊被悔恨压垮的旧神像。",
          "characters_present": [
            "char_shenlu",
            "char_zhouming"
          ],
          "elements": [
            {
              "type": "action",
              "text": "沈鹭走出院子。雾又起来了，灰白的雾气从山脚漫上来，缠绕着渔网和旧砖房。她回头望了一眼——周明还坐在那张八仙桌前，背影佝偻，一动不动，像一尊被岁月和悔恨压垮的旧神像。"
            },
            {
              "type": "transition",
              "text": "淡出"
            }
          ],
          "needs_review": false
        }
      ]
    },
    {
      "id": "unit_ch3",
      "source_chapter": 3,
      "title": "第三章 最后的晚餐",
      "summary": "沈鹭来到钱记海鲜，向钱德旺追问姐姐沈鸿失踪当晚的最后一顿饭。钱德旺表面热情，实则恐惧万分，借故躲进后厨偷偷打电话通风报信。沈鹭趁隙翻出五年前的旧账本，发现姐姐失踪当天的流水记录旁有人补了一行小字：「替阿昌带话，西仓，子时」。钱德旺发现后惊恐失态，沈鹭逼问之下，从他眼中看到了活生生的恐惧——他不是不记得，是不敢说。",
      "scenes": [
        {
          "id": "sc_3_01",
          "heading": {
            "int_ext": "EXT",
            "location": "雾港镇街巷·钱记海鲜门外",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭穿过暮色中的雾港街巷，来到钱记海鲜门前，打量那块破败的旧招牌。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "action",
              "text": "暮色渐沉，雾港的街巷笼在一层灰蓝的薄雾里。街灯还没亮，石板路面湿漉漉的，映着零星店铺透出的昏黄灯光。"
            },
            {
              "type": "action",
              "text": "沈鹭裹紧外套，沿街走来。她在一家店面门前停住，抬头打量。"
            },
            {
              "type": "shot",
              "text": "仰角：一块褪色的鎏金招牌——「钱记海鲜」四个字红漆剥落，露出底下灰白的木头，在潮湿的海风里微微晃动。"
            },
            {
              "type": "action",
              "text": "沈鹭的目光在招牌上停留片刻，深吸一口气，推门而入。"
            }
          ],
          "needs_review": false
        },
        {

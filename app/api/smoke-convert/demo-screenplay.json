    "outline": [
      {
        "id": "beat_01",
        "title": "归港",
        "summary": "沈鹭五年后回到雾港，小镇依旧被浓雾笼罩。她遇到修船的阿昌叔，老人劝她别再捞沉在海底的事。在听潮客栈落脚，老板娘阿珍话里有话地警告她别翻旧账。沈鹭对着姐姐的照片发誓要找回她。",
        "structure_tag": "setup",
        "chapter_range": [
          1,
          1
        ]
      },
      {
        "id": "beat_02",
        "title": "旧案",
        "summary": "沈鹭找到当年经手姐姐案子的退休刑警周明。周明承认自己没尽全力，透露沈鸿失踪前一周曾来打听如何匿名举报走私——这条线索从未写入案卷。周明劝她收手，暗示港里有人根扎得很深。",
        "structure_tag": "rising_action",
        "chapter_range": [
          2,
          2
        ]
      },
      {
        "id": "beat_03",
        "title": "最后的晚餐",
        "summary": "沈鹭到钱记海鲜调查姐姐失踪当晚的最后一餐。钱德旺言辞闪烁、恐惧异常。沈鹭偷翻旧账本，发现姐姐那天的记录旁有一行小字：'替阿昌带话，西仓，子时'。钱德旺发现后吓得打电话通风报信。",
        "structure_tag": "rising_action",
        "chapter_range": [
          3,
          3
        ]
      },
      {
        "id": "beat_04",
        "title": "照片与真相",
        "summary": "沈鹭夜探西边废弃仓库，阿昌现身，交出沈鸿五年前留给妹妹的信。信中揭示：沈鸿因追查走私被追杀，阿昌拼死救她，沈鸿泅水逃到对岸渔村躲藏至今。信中指出真正可怕的是那个穿制服、给走私望风通气的内鬼。阿昌确认沈鸿还活着，阿珍一直在接济她。",
        "structure_tag": "climax",
        "chapter_range": [
          4,
          5
        ]
      },
      {
        "id": "beat_05",
        "title": "雾散",
        "summary": "沈鹭得知姐姐还活着，追问内鬼身份。阿昌终于决定说出一切。沈鹭以记者的身份发誓要让见不得光的东西见光。天边泛起亮色，压了雾港五年的浓雾开始被风吹散。",
        "structure_tag": "resolution_setup",
        "chapter_range": [
          5,
          5
        ]
      }
    ]
  },
  "script": [
    {
      "id": "unit_ch1",
      "source_chapter": 1,
      "title": "第一章 归港",
      "summary": "沈鹭在浓雾中回到阔别五年的雾港。车站冷清，老街破败，童年的记忆与姐姐沈鸿失踪的疑团交织在一起。她在码头找到修船补网的阿昌叔，老人劝她别再追问沉入海底的旧事。入夜后她入住听潮客栈，老板娘阿珍欲言又止，暗示镇上有人不愿旧账被翻起。沈鹭在房间里对着姐妹合影立誓，一定要把姐姐找回来。",
      "scenes": [
        {
          "id": "sc_1_01",
          "heading": {
            "int_ext": "EXT",
            "location": "雾港长途汽车站",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭乘长途汽车回到雾港，车站冷清，雾气弥漫，她独自走向海边。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "action",
              "text": "浓雾中，一辆长途汽车缓缓停下，发动机咳出一口黑烟后熄火。车门打开，沈鹭拎着行李走下来。咸腥的雾气立刻贴上她的脸颊，她微微一激灵。"
            },
            {
              "type": "action",
              "text": "车站只有一盏路灯亮着，昏黄的光晕在雾里化开。灯下蹲着两个三轮车夫，懒洋洋地抽着烟，没人抬头看她。"
            },
            {
              "type": "action",
              "text": "沈鹭把外套领子竖起来，环顾四周。雾港的天和海混成一团灰白，分不清哪里是水、哪里是天。她深吸一口气，沿着记忆里的石板路往海边走去。"
            },
            {
              "type": "action",
              "text": "路两边的铺子大多关着门。她经过一家糖水铺——招牌还在，玻璃却碎了一块，用纸板糊着。再往前，是她和姐姐读过的小学，铁门锈得发红。"
            },
            {
              "type": "action",
              "text": "沈鹭停在小学校门前，目光落在锈红的铁门上。记忆闪回——放学时分，姐姐沈鸿站在门口等她，一手牵着她，一手举着一支冰棍，两个人分着吃。海风把两个女孩的头发吹向同一个方向。"
            },
            {
              "type": "action",
              "text": "沈鹭回过神，继续往前走。石板路的尽头，码头在雾中若隐若现。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_02",
          "heading": {
            "int_ext": "EXT",
            "location": "雾港码头·修船木棚",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭在码头找到阿昌叔，试图询问姐姐失踪的真相，阿昌避而不答，劝她别再追问。",
          "characters_present": [
            "char_shenlu",
            "char_achang"
          ],
          "elements": [
            {
              "type": "action",
              "text": "退潮了，海滩上裸露出一片黑色礁石和搁浅的小船。修船的木棚还立在老地方，棚子里亮着一盏昏黄的灯。一个佝偻的身影正蹲在船板边，借着灯光补网。"
            },
            {
              "type": "action",
              "text": "沈鹭走近，在棚外停了一下，轻声开口。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "阿昌叔。"
            },
            {
              "type": "action",
              "text": "老人的手停住了。他抬起头，浑浊的眼睛在雾里费力地辨认着来人。忽然手一抖，鱼线啪地落进水里。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "……是小鹭？"
            },
            {
              "type": "action",
              "text": "他的声音又干又涩。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "你姐姐的事，过去这么多年了，你回来做什么。"
            },
            {
              "type": "action",
              "text": "沈鹭把行李放在船板上，在他对面蹲下。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我想知道她到底去了哪儿。周叔他们说是意外落水。可阿昌叔，您是看着我和姐姐在这片海边长大的，您比谁都清楚——沈鸿的水性，比港里大半的渔民都好。她不可能就那么淹死。"
            },
            {
              "type": "action",
              "text": "阿昌没有接话。他重新捡起鱼线，却半天没穿进网眼里，那双手抖得厉害。过了很久，他才把目光投向雾里看不见的海。"
            },
            {
              "type": "dialogue",
              "character": "char_achang",
              "delivery": "normal",
              "line": "有些事啊，沉到海底了，就别再捞了。捞上来的，未必是你想要的。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我想要的，是真相。"
            },
            {
              "type": "action",
              "text": "老人摇摇头，没再说话，只是一下一下地补着那张永远补不完的网。沈鹭看了他一会儿，站起身，拍了拍裤子上的灰。临走前回头望了一眼——雾里，老人佝偻的背影一动不动，像一块被海水泡了太久的礁石。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_03",
          "heading": {
            "int_ext": "INT",
            "location": "听潮客栈·前台",
            "time": "NIGHT"
          },
          "mode": "normal",
          "synopsis": "沈鹭入住听潮客栈，老板娘阿珍认出她后欲言又止，暗示镇上有人不愿旧事重提。",
          "characters_present": [
            "char_shenlu",
            "char_azhen"
          ],
          "elements": [
            {
              "type": "action",
              "text": "天彻底黑下来。沈鹭推开听潮客栈的门，门上的风铃叮铃作响。前台后面，阿珍正低头翻着账本，闻声抬头。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "哎哟，这不是小鹭嘛！"
            },
            {
              "type": "action",
              "text": "阿珍又惊又喜，随即那喜色里掺进了别的东西，笑容僵了一瞬。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "你怎么……回来了？"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "回来住几天。阿珍姐，给我开个看得见海的房间吧。"
            },
            {
              "type": "action",
              "text": "沈鹭把身份证递过去。阿珍接过证件，登记的手却慢了下来。她抬头看了看门口，压低声音。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "小鹭，姐多嘴一句。你姐姐那事，镇上没人愿意提。你要是来散心，姐欢迎；你要是来翻旧账……"
            },
            {
              "type": "action",
              "text": "她顿了顿，声音压得更低。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "这港子小，风一吹，什么话都传到不该传的人耳朵里。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "什么人？"
            },
            {
              "type": "action",
              "text": "阿珍像是说漏了嘴，慌忙把钥匙塞给她。"
            },
            {
              "type": "dialogue",
              "character": "char_azhen",
              "delivery": "normal",
              "line": "二楼最里头那间。早点歇着，海边夜里凉。"
            },
            {
              "type": "action",
              "text": "说完便低头忙别的去了，再不肯多看她一眼。沈鹭握着钥匙，看了阿珍片刻，转身上楼。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_1_04",
          "heading": {
            "int_ext": "INT",
            "location": "听潮客栈·二楼房间",
            "time": "NIGHT"
          },
          "mode": "normal",
          "synopsis": "沈鹭在房间里取出与姐姐的合影，对着照片轻声立誓，窗外雾海沉沉。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "action",
              "text": "房间不大，一床一桌，窗外就是漆黑的海。沈鹭放下行李，从包里取出一张照片，摆在桌上。"
            },
            {
              "type": "action",
              "text": "照片特写——两个女孩并肩站在码头，小的那个咧着嘴笑，大的那个揽着妹妹的肩，眼睛却望着远处的海平线，像在想什么心事。"
            },
            {
              "type": "action",
              "text": "沈鹭的指尖轻轻划过照片中姐姐的脸。她望向窗外，雾压着海，海托着雾，一片混沌。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "姐，我回来了。这次，我一定把你找回来。"
            },
            {
              "type": "action",
              "text": "窗外，浓雾沉沉地压在海面上，一夜都没有散。"
            }
          ],
          "needs_review": false
        }
      ]
    },
    {
      "id": "unit_ch2",
      "source_chapter": 2,
      "title": "第二章 旧案",
      "summary": "沈鹭拜访退休老刑警周明，追问姐姐沈鸿失踪案的真相。周明承认当年因快退休、妻子生病等压力草草结案，并透露沈鸿失踪前一周曾来打听举报走私的渠道——这条线索从未写入案卷。周明反复劝沈鹭收手，暗示镇上盘根错节的势力仍在。沈鹭不为所动，决心追查到底。",
      "scenes": [
        {
          "id": "sc_2_01",
          "heading": {
            "int_ext": "EXT",
            "location": "半山腰周明家院子",
            "time": "DAY"
          },
          "mode": "normal",
          "synopsis": "沈鹭来到周明家，老人在院子里浇花，转身见到沈鹭，神情复杂。",
          "characters_present": [
            "char_shenlu",
            "char_zhouming"
          ],
          "elements": [
            {
              "type": "action",
              "text": "半山腰，一栋孤零零的旧砖房。院子里横七竖八晾着渔网，墙上挂着一张褪了色的警队合影，玻璃相框落满灰。周明背对着门，正给几盆半死不活的兰花浇水。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "周叔。"
            },
            {
              "type": "action",
              "text": "浇水的手顿了顿。周明转过身——比五年前老了不止五岁，背驼了，头发白透了。他看着沈鹭，浑浊的眼里闪过一丝复杂的东西：有意外，有躲闪，还有一点说不清的愧。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "……进来吧。"
            },
            {
              "type": "action",
              "text": "他叹了口气。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "我就知道，你迟早会找上门。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_2_02",
          "heading": {
            "int_ext": "INT",
            "location": "周明家客厅",
            "time": "DAY"
          },
          "mode": "normal",
          "synopsis": "周明给沈鹭倒茶，讲述当年沈鸿案经过，承认自己没尽全力。沈鹭追问，周明透露沈鸿失踪前一周曾来打听举报走私的事。",
          "characters_present": [
            "char_shenlu",
            "char_zhouming"
          ],
          "elements": [
            {
              "type": "action",
              "text": "屋里陈设简单，一张八仙桌，几把旧椅子。周明给沈鹭倒了杯粗茶，端杯子的手有点抖，茶水洒了几滴在桌上。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "沈鸿的案子，是我经手的。"
            },
            {
              "type": "action",
              "text": "他在她对面坐下，目光落在自己布满老年斑的手背上。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "那年她在钱记海鲜吃完晚饭，一个人往码头方向走，再没回来。第三天，西湾的渔民捞起一只女鞋，是她的。我们查了半个月，最后定了意外落水。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "半个月。"
            },
            {
              "type": "action",
              "text": "沈鹭重复了一遍这三个字，声音很轻，却像针。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "周叔，您当了一辈子刑警，破过那么多案子。我问您一句良心话——这个结论，您自己信吗？"
            },
            {
              "type": "action",
              "text": "周明没有立刻回答。他端起茶杯，又放下，喉结动了动。屋外的风穿过院子里的渔网，发出呜呜的声响，像谁在低声哭。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "那阵子，港里不太平。"
            },
            {
              "type": "action",
              "text": "他终于开口，声音压得很低。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "走私的、跑黑市的，半夜里船来船往，水浑得很。上头三天两头催着结案，说一个失踪案拖着影响渔汛、影响招商。我……我那时候快退休了，老婆又病着，等着用钱。"
            },
            {
              "type": "action",
              "text": "他闭上眼。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "我承认，那个案子，我没尽全力。"
            },
            {
              "type": "action",
              "text": "沈鹭的心一点点沉下去，可她仍逼着自己问下去。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "姐姐出事前，有没有什么反常？她有没有找过您，或者找过谁？"
            },
            {
              "type": "action",
              "text": "周明的身子几不可察地僵了一下。他沉默了很久，久到沈鹭以为他不会答了。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "出事前大概一个星期，沈鸿来过一趟所里。她说……她想问问，举报走私，该找哪个部门，怎么才能不被人知道是她报的。"
            },
            {
              "type": "action",
              "text": "老人的声音抖了起来。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "我当时只当她是好奇，随口应付了她几句。我要是当时多问一句，多留个心……"
            },
            {
              "type": "action",
              "text": "他没说下去，一只手捂住了脸。沈鹭的呼吸急了——姐姐失踪前一周，去打听过怎么举报走私。这条线索，案卷里一个字都没有。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "这些，为什么不写进案卷？"
            },
            {
              "type": "action",
              "text": "周明放下手，眼神又恢复了那种躲闪的浑浊。"
            },
            {
              "type": "dialogue",
              "character": "char_zhouming",
              "delivery": "normal",
              "line": "小鹭，听叔一句劝。这港子小，认人。有些人，你现在看着是退了、老了、不管事了，可他们的根还扎在这片水底下，盘根错节。你一个姑娘家，查到一半最难收手——到时候，怕是连你自己都搭进去。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_2_03",
          "heading": {
            "int_ext": "EXT",
            "location": "周明家院子外",
            "time": "DAY"
          },
          "mode": "normal",
          "synopsis": "沈鹭离开，在门口表明决心。走出院子后回头望，周明佝偻的背影如被岁月和悔恨压垮的旧神像。雾又起来了。",
          "characters_present": [
            "char_shenlu",
            "char_zhouming"
          ],
          "elements": [
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "那也比让我姐姐烂在一只鞋里强。"
            },
            {
              "type": "action",
              "text": "沈鹭站起身，声音不高，却字字咬得很死。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "周叔，谢谢您今天肯跟我说这些。我姐不是会半路放弃的人。"
            },
            {
              "type": "action",
              "text": "她在门口停下，回头。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "我也不是。"
            },
            {
              "type": "action",
              "text": "沈鹭走出院子。雾又起来了。她回头望了一眼——周明还坐在那张八仙桌前，背影佝偻，一动不动，像一尊被岁月和悔恨压垮的旧神像。"
            }
          ],
          "needs_review": false
        }
      ]
    },
    {
      "id": "unit_ch3",
      "source_chapter": 3,
      "title": "第三章 最后的晚餐",
      "summary": "沈鹭来到钱记海鲜，钱德旺强装热情却处处露怯。沈鹭点了一碗和姐姐当年一样的鱼面，追问沈鸿失踪当晚的情况。钱德旺敷衍搪塞，躲进后厨偷偷打电话通风报信。沈鹭趁隙翻出五年前的旧账本，在姐姐失踪当天的流水记录旁发现一行潦草小字：「替阿昌带话，西仓，子时」——原来姐姐那晚是去赴约。钱德旺撞见后恐惧到失语，沈鹭终于明白，他不是不记得，是不敢说。",
      "scenes": [
        {
          "id": "sc_3_01",
          "heading": {
            "int_ext": "INT",
            "location": "钱记海鲜",
            "time": "DUSK"
          },
          "mode": "normal",
          "synopsis": "沈鹭走进钱记海鲜，钱德旺认出她后强装热情，沈鹭点了一碗和姐姐当年一样的鱼面，并直接追问沈鸿失踪当晚的情况。",
          "characters_present": [
            "char_shenlu",
            "char_qiandewang"
          ],
          "elements": [
            {
              "type": "action",
              "text": "钱记海鲜店内，昏黄的灯光照着零星两桌客人。电视开着，没人看。鎏金招牌旧得快看不清字，红漆剥落，露出底下灰白的木头。"
            },
            {
              "type": "action",
              "text": "钱德旺挺着撑起围裙的肚子，一眼瞥见推门进来的沈鹭。他脸上的笑先僵了一下，随即又堆起来，堆得有点太满。"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "哎哟，这是……小鹭吧？沈鸿的妹妹！"
            },
            {
              "type": "action",
              "text": "他迎上来，肥厚的手在油腻的围裙上擦了又擦。"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "长这么大了，出息了，听说在大城市当记者呢。坐坐坐，今天叔请，想吃什么尽管点。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "钱叔客气了。"
            },
            {
              "type": "action",
              "text": "沈鹭在靠柜台的位子坐下，目光不动声色地扫过那张油亮的柜台。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "就一碗鱼面吧，跟我姐当年点的一样。"
            },
            {
              "type": "action",
              "text": "钱德旺脸上的笑几不可察地抽了一下。"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "……行，鱼面，马上。"
            },
            {
              "type": "action",
              "text": "他转身要走，沈鹭开口留住他。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "钱叔，我想问问，我姐失踪那天晚上，是在您这儿吃的最后一顿饭，对吧？"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "是、是有这么回事。"
            },
            {
              "type": "action",
              "text": "钱德旺的眼神开始飘。"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "那天她一个人来的，点了碗鱼面，吃完就走了，没什么特别的。"
            },
            {
              "type": "dialogue",
              "character": "char_shenlu",
              "delivery": "normal",
              "line": "她走的时候，是几点？有没有跟店里谁说过话？或者，有没有人在外头等她？"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "这……"
            },
            {
              "type": "action",
              "text": "钱德旺的额头沁出一层细汗，飞快地朝门外瞟了一眼，又迅速收回目光。"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "姑娘啊，五年前的事了，店里天天人来人往，谁记得清那么细。你别多想，啊，她就是吃完饭走的，普普通通一顿饭。"
            },
            {
              "type": "action",
              "text": "他几乎是落荒而逃地钻进了后厨。"
            },
            {
              "type": "dialogue",
              "character": "char_qiandewang",
              "delivery": "normal",
              "line": "我去给你下面！"
            },
            {
              "type": "action",
              "text": "沈鹭垂下眼，端起桌上的茶慢慢喝。后厨传来锅碗瓢盆的响动，夹杂着钱德旺压着嗓子打电话的声音，断续飘来几个字——「……她妹妹回来了……我什么都没说……你们看着办……」"
            },
            {
              "type": "action",
              "text": "沈鹭的心猛地一紧，端茶的手停在半空。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_3_02",
          "heading": {
            "int_ext": "INT",
            "location": "钱记海鲜 - 柜台后",
            "time": "CONTINUOUS"
          },
          "mode": "normal",
          "synopsis": "沈鹭趁钱德旺在后厨，翻出五年前的旧账本，发现姐姐失踪当晚的流水记录旁有一行潦草小字——「替阿昌带话，西仓，子时」。",
          "characters_present": [
            "char_shenlu"
          ],
          "elements": [
            {
              "type": "action",
              "text": "沈鹭起身，装作去看墙上的菜牌，悄悄绕到柜台后。柜台下层堆着几本落满灰的旧账本，按年份码着。"
            },
            {
              "type": "action",
              "text": "她屏住呼吸，飞快地抽出五年前那一本，借着昏暗的灯光一页页翻过去，翻到姐姐失踪的那个月。手指停住了。"
            },
            {
              "type": "shot",
              "text": "特写：泛黄的账本纸页上，一行流水记录——「沈鸿 鱼面 一碗」。旁边，用极小极潦草的字迹补了一行：「替阿昌带话，西仓，子时」。"
            },
            {
              "type": "action",
              "text": "沈鹭的心跳漏了一拍，又狂跳起来。她盯着那行字，脑海中拼凑出画面——姐姐那天晚上根本不是吃完饭就走，她是去赴一个约。一个跟阿昌、跟西边的仓库、跟午夜有关的约。"
            }
          ],
          "needs_review": false
        },
        {
          "id": "sc_3_03",
          "heading": {
            "int_ext": "INT",
            "location": "钱记海鲜",
            "time": "CONTINUOUS"
          },
          "mode": "normal",
          "synopsis": "钱德旺端着面冲出后厨，撞见沈鹭在柜台后。沈鹭不动声色地合上账本，直接质问姐姐替阿昌去西仓带话的事。钱德旺恐惧到失语，沈鹭终于明白——他不是不记得，是不敢说。",
